{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhanzhan.example/schemas/onboarding-state.schema.json",
  "title": "Agent onboarding state",
  "type": "object",
  "required": ["project_version", "tenant_id", "stage", "status", "evidence", "updated_at"],
  "properties": {
    "project_version": {"type": "string"},
    "tenant_id": {"type": "string"},
    "stage": {"integer", "minimum": 0, "maximum": 8},
    "status": {"enum": ["not_started", "in_progress", "blocked", "passed"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}

